{
  "rewrites": [
    {
      "source": "/bkk-sticker/:match*",
      "destination": "/:match*"
    },
    { "source": "/bkk-sticker", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://pop.meme http://localhost:3000"
        }
      ]
    }
  ]
}
